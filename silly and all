/* ---------- Screen navigation ---------- */
const completed = { memory:false, bubble:false, star:false, flower:false, quiz:false, cats:false };

function openScreen(name){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+name).classList.add('active');
  if(name==='memory' && !memoryStarted) startMemory();
  if(name==='bubble' && !bubbleStarted) startBubble();
  if(name==='star' && !starStarted) startStar();
  if(name==='flower' && !flowerStarted) startFlower();
  if(name==='quiz' && !quizStarted) startQuiz();
  if(name==='cats' && !catsStarted) startCats();
  if(name==='final') floatHearts(14);
}

function markComplete(game){
  completed[game] = true;
  document.getElementById('badge-'+game).classList.add('show');
  document.querySelector('.progress-dot[data-game="'+game+'"]').classList.add('done');
  if(Object.values(completed).every(v=>v)){
    document.getElementById('finalBtn').classList.add('show');
  }
}

function showModal(game, customMessage){
  document.getElementById('modalTitle').textContent = "Level cleared! 🎉";
  document.getElementById('modalMessage').textContent = customMessage || pickRandom(messagesByGame[game]);
  document.getElementById('modalBackdrop').classList.add('show');
  sparkleBurst();
}
function closeModal(){
  document.getElementById('modalBackdrop').classList.remove('show');
  openScreen('hub');
}

/* ============ MEMORY GAME ============ */
let memoryStarted = false;
function startMemory(){
  memoryStarted = true;
  const icons = ['🌸','🍓','🌙','⭐','🍩','🦋','🍡','🍂'];
  let deck = [...icons, ...icons];
  deck = deck.sort(()=>Math.random()-0.5);

  const grid = document.getElementById('memoryGrid');
  grid.innerHTML = '';
  let flipped = [];
  let lock = false;
  let matches = 0;

  deck.forEach((icon)=>{
    const card = document.createElement('div');
    card.className = 'mem-card';
    card.innerHTML = `<span class="face">${icon}</span><span class="back">✦</span>`;
    card.addEventListener('click', ()=>{
      if(lock || card.classList.contains('flipped') || card.classList.contains('matched')) return;
      card.classList.add('flipped');
      flipped.push(card);
      if(flipped.length === 2){
        lock = true;
        const [a,b] = flipped;
        const aIcon = a.querySelector('.face').textContent;
        const bIcon = b.querySelector('.face').textContent;
        if(aIcon === bIcon){
          a.classList.add('matched');
          b.classList.add('matched');
          flipped = [];
          lock = false;
          matches++;
          document.getElementById('memoryScore').textContent = matches;
          if(matches === icons.length){
            setTimeout(()=>{ markComplete('memory'); showModal('memory'); }, 400);
          }
        } else {
          setTimeout(()=>{
            a.classList.remove('flipped');
            b.classList.remove('flipped');
            flipped = [];
            lock = false;
          }, 700);
        }
      }
    });
    grid.appendChild(card);
  });
}

/* ============ BUBBLE GAME ============ */
let bubbleStarted = false;
let bubbleScoreVal = 0;
let bubbleInterval = null;
const BUBBLE_TARGET = 22;
function startBubble(){
  bubbleStarted = true;
  bubbleScoreVal = 0;
  document.getElementById('bubbleScore').textContent = 0;
  const field = document.getElementById('bubbleField');
  field.innerHTML = '';
  const colors = ['#D998AC','#8FBFAE','#D9AE6E','#9C8DC7'];

  function spawnBubble(){
    if(bubbleScoreVal >= BUBBLE_TARGET) return;
    const b = document.createElement('button');
    b.className = 'bubble';
    const size = 32 + Math.random()*28;
    b.style.width = size+'px';
    b.style.height = size+'px';
    b.style.left = (Math.random()*85)+'%';
    b.style.setProperty('--bubble-color', pickRandom(colors));
    const duration = 6.5 + Math.random()*4;
    b.style.animationDuration = duration+'s';
    b.addEventListener('click', ()=>{
      if(b.dataset.popped) return;
      b.dataset.popped = "1";
      bubbleScoreVal++;
      document.getElementById('bubbleScore').textContent = bubbleScoreVal;
      b.remove();
      if(bubbleScoreVal >= BUBBLE_TARGET){
        clearInterval(bubbleInterval);
        markComplete('bubble');
        showModal('bubble');
      }
    });
    field.appendChild(b);
    setTimeout(()=>{ if(b.parentNode) b.remove(); }, duration*1000+200);
  }

  clearInterval(bubbleInterval);
  bubbleInterval = setInterval(spawnBubble, 650);
  spawnBubble();
}

/* ============ STAR GAME ============ */
let starStarted = false;
let starScoreVal = 0;
let starInterval = null;
const STAR_TARGET = 16;
function startStar(){
  starStarted = true;
  starScoreVal = 0;
  document.getElementById('starScore').textContent = 0;
  const field = document.getElementById('starField');
  const basket = document.getElementById('basket');
  field.querySelectorAll('.falling-star').forEach(s=>s.remove());

  function moveBasketTo(clientX){
    const rect = field.getBoundingClientRect();
    let x = ((clientX - rect.left) / rect.width) * 100;
    x = Math.max(4, Math.min(96, x));
    basket.style.left = x+'%';
  }
  field.addEventListener('mousemove', (e)=> moveBasketTo(e.clientX));
  field.addEventListener('touchmove', (e)=>{ moveBasketTo(e.touches[0].clientX); e.preventDefault(); }, {passive:false});

  function spawnStar(){
    if(starScoreVal >= STAR_TARGET) return;
    const s = document.createElement('div');
    s.className = 'falling-star';
    s.textContent = '⭐';
    s.style.left = (5+Math.random()*88)+'%';
    const duration = 3.8 + Math.random()*2.2;
    s.style.animationDuration = duration+'s';
    field.appendChild(s);

    let popped = false;
    const checkInterval = setInterval(()=>{
      if(popped) { clearInterval(checkInterval); return; }
      const sRect = s.getBoundingClientRect();
      const bRect = basket.getBoundingClientRect();
      if(sRect.bottom >= bRect.top && sRect.left < bRect.right && sRect.right > bRect.left){
        popped = true;
        clearInterval(checkInterval);
        s.remove();
        starScoreVal++;
        document.getElementById('starScore').textContent = starScoreVal;
        if(starScoreVal >= STAR_TARGET){
          clearInterval(starInterval);
          markComplete('star');
          showModal('star');
        }
      }
    }, 60);

    setTimeout(()=>{
      clearInterval(checkInterval);
      if(s.parentNode) s.remove();
    }, duration*1000+100);
  }

  clearInterval(starInterval);
  starInterval = setInterval(spawnStar, 1000);
  spawnStar();
}

/* ============ HE LOVES ME / HE LOVES ME NOT ============ */
let flowerStarted = false;
function startFlower(){
  flowerStarted = true;
  buildFlowerRound(true);
}

function buildFlowerRound(firstTime){
  const field = document.getElementById('flowerField');
  field.innerHTML = `
    <div class="phrase-label" id="phraseLabel">Pick a petal to begin</div>
    <div class="flower-wrap" id="flowerWrap">
      <span class="flower-emoji">🌼</span>
    </div>
  `;
  const wrap = document.getElementById('flowerWrap');
  const label = document.getElementById('phraseLabel');
  const colors = ['#D998AC','#8FBFAE','#D9AE6E','#9C8DC7'];

  // odd petal count guarantees the sequence starts and ends on "He loves me"
  const petalCount = pickRandom([7, 9, 11]);
  const center = 115, radius = 78;
  let index = 0;
  let done = false;

  for(let i=0;i<petalCount;i++){
    const angle = (360/petalCount)*i;
    const rad = angle * Math.PI / 180;
    const x = center + radius*Math.sin(rad) - 12;
    const y = center - radius*Math.cos(rad) - 20;
    const petal = document.createElement('div');
    petal.className = 'petal';
    petal.style.left = x+'px';
    petal.style.top = y+'px';
    petal.style.transform = `rotate(${angle}deg)`;
    petal.style.background = colors[i % colors.length];
    petal.addEventListener('click', ()=>{
      if(done || petal.classList.contains('plucked')) return;
      const phrase = (index % 2 === 0) ? "He loves me..." : "He loves me not...";
      label.textContent = phrase;
      petal.style.transform = `translate(${Math.sin(rad)*45}px, ${-Math.cos(rad)*45}px) rotate(${angle}deg) scale(0.4)`;
      petal.classList.add('plucked');
      index++;
      if(index === petalCount){
        done = true;
        setTimeout(()=>{
          label.textContent = "He loves me. ❤";
          label.style.color = 'var(--sage)';
          if(firstTime){
            markComplete('flower');
            showModal('flower');
          } else {
            sparkleBurst();
          }
          const restart = document.createElement('button');
          restart.className = 'flower-restart';
          restart.textContent = 'Pick another flower';
          restart.addEventListener('click', ()=> buildFlowerRound(false));
          field.appendChild(restart);
        }, 450);
      }
    });
    wrap.appendChild(petal);
  }
}

/* ============ RESCUE CATS ============ */
let catsStarted = false;
let catsRescued = 0;
const CATS_TARGET = 6;
function startCats(){
  catsStarted = true;
  catsRescued = 0;
  document.getElementById('catsScore').textContent = 0;
  document.getElementById('catCaption').textContent = '';
  renderCage(1);
}

function renderCage(pinCount){
  const cage = document.getElementById('cage');
  const door = document.getElementById('cageDoor');
  const cat = document.getElementById('catEmoji');
  const pinsRow = document.getElementById('pinsRow');

  door.classList.remove('open');
  cat.classList.remove('escape');
  pinsRow.innerHTML = '';

  let remaining = pinCount;
  for(let i=0;i<pinCount;i++){
    const pin = document.createElement('div');
    pin.className = 'pin';
    pin.addEventListener('click', ()=>{
      if(pin.classList.contains('pulled')) return;
      pin.classList.add('pulled');
      remaining--;
      if(remaining <= 0){
        freeCat(pinCount);
      }
    });
    pinsRow.appendChild(pin);
  }
}

function freeCat(lastPinCount){
  const door = document.getElementById('cageDoor');
  const cat = document.getElementById('catEmoji');
  door.classList.add('open');
  cat.classList.add('escape');
  catsRescued++;
  document.getElementById('catsScore').textContent = catsRescued;
  document.getElementById('catCaption').textContent = pickRandom(messagesByGame.cats);
  sparkleBurst();

  if(catsRescued === CATS_TARGET){
    markComplete('cats');
    setTimeout(()=> showModal('cats', catsFirstTargetMessage), 500);
  }

  setTimeout(()=>{
    const nextPinCount = Math.min(1 + Math.floor(catsRescued/2), 5);
    renderCage(nextPinCount);
  }, 1300);
}

/* ============ LOVE NOTES QUIZ ============ */
let quizStarted = false;
function startQuiz(){
  quizStarted = true;
  let index = 0;
  const card = document.getElementById('quizCard');

  function renderQuestion(){
    if(index >= QUIZ_QUESTIONS.length){
      markComplete('quiz');
      showModal('quiz', "Every answer was correct because every answer was about you. Perfect score, meri jaan.");
      return;
    }
    const item = QUIZ_QUESTIONS[index];
    card.innerHTML = `
      <div class="quiz-question">${item.q}</div>
      <div class="quiz-options" id="quizOptions"></div>
      <div class="quiz-reply" id="quizReply"></div>
      <div class="quiz-progress">Question ${index+1} of ${QUIZ_QUESTIONS.length}</div>
    `;
    const optsWrap = document.getElementById('quizOptions');
    const replyEl = document.getElementById('quizReply');
    item.options.forEach((opt, i)=>{
      const btn = document.createElement('button');
      btn.className = 'quiz-option';
      btn.textContent = opt;
      btn.addEventListener('click', ()=>{
        if(btn.dataset.locked) return;
        optsWrap.querySelectorAll('.quiz-option').forEach(o=> o.dataset.locked = "1");
        if(i === item.correct){
          btn.classList.add('correct');
          replyEl.textContent = item.reply;
        } else {
          btn.classList.add('wrong');
          optsWrap.children[item.correct].classList.add('correct');
          replyEl.textContent = pickRandom(wrongReplies) + " " + item.reply;
        }
        replyEl.classList.add('show');
        setTimeout(()=>{ index++; renderQuestion(); }, 1600);
      });
      optsWrap.appendChild(btn);
    });
  }

  renderQuestion();
}
