<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Little Cozy Arcade, Just For You</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  /* Dim, warm, low-glare palette on purpose. No pure white anywhere,
     nothing high-brightness or flashing, gentle on eyes/migraines. */
  :root{
    --bg-top: #241E33;
    --bg-bottom: #2E2440;
    --panel: #3B3152;
    --panel-soft: #473A5E;
    --panel-softer: #52466B;
    --text: #E7DEE9;
    --text-soft: #B8A9C9;
    --rose: #D998AC;
    --rose-deep: #C77E95;
    --sage: #8FBFAE;
    --sage-deep: #6FA391;
    --gold: #D9AE6E;
    --gold-deep: #C79A54;
    --lavender: #9C8DC7;
    --lavender-deep: #8677B3;
    --shadow: 0 10px 28px rgba(15,10,25,0.35);
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    font-family: 'Nunito', sans-serif;
    color: var(--text);
    background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 100%);
    overflow-x: hidden;
  }

  h1, h2, h3, .display {
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }

  button {
    font-family: 'Nunito', sans-serif;
    cursor: pointer;
    border: none;
    outline-offset: 3px;
  }
  button:focus-visible, .card:focus-visible {
    outline: 3px solid var(--lavender);
  }

  /* ---------- Ambient glow drifters (soft, dim, no flashing) ---------- */
  .glow-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    opacity: 0.35;
    filter: blur(18px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .glow { animation: drift linear infinite; }
  }
  @keyframes drift {
    from { transform: translate(-8vw, 0); }
    to { transform: translate(108vw, 0); }
  }

  /* ---------- Sparkle burst on wins ---------- */
  .sparkle-particle {
    position: fixed;
    width: 8px; height: 8px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 30;
    opacity: 0.9;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sparkle-particle { animation: sparkleUp 0.9s ease-out forwards; }
  }
  @keyframes sparkleUp {
    to { transform: translateY(-100px) scale(0.3); opacity: 0; }
  }

  /* ---------- Floating hearts on final screen ---------- */
  .heart-particle {
    position: fixed;
    bottom: -20px;
    font-size: 18px;
    pointer-events: none;
    z-index: 30;
    opacity: 0.85;
  }
  @media (prefers-reduced-motion: no-preference) {
    .heart-particle { animation: floatHeart 4s ease-in forwards; }
  }
  @keyframes floatHeart {
    to { transform: translateY(-70vh) translateX(var(--drift, 0px)); opacity: 0; }
  }

  /* ---------- Layout shell ---------- */
  .screen {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: none;
    flex-direction: column;
    align-items: center;
    padding: 40px 20px 60px;
  }
  .screen.active { display: flex; }

  .top-bar {
    width: 100%;
    max-width: 720px;
    display: flex;
    justify-content: flex-start;
    margin-bottom: 12px;
  }
  .back-btn {
    background: var(--panel-soft);
    color: var(--text);
    padding: 8px 16px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
    box-shadow: var(--shadow);
    transition: background .2s ease, transform .15s ease;
  }
  .back-btn:hover { background: var(--panel-softer); transform: translateX(-2px); }

  /* ---------- Mascot: a sleepy little star ---------- */
  .mascot-wrap {
    position: fixed;
    bottom: 18px;
    right: 18px;
    z-index: 5;
    text-align: center;
    cursor: pointer;
  }
  .mascot-bubble {
    background: var(--panel);
    border-radius: 16px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 700;
    box-shadow: var(--shadow);
    margin-bottom: 6px;
    max-width: 170px;
    color: var(--text);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity .4s ease, transform .4s ease;
    pointer-events: none;
  }
  .mascot-bubble.show { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: no-preference) {
    .mascot-svg { animation: bob 3.8s ease-in-out infinite; }
  }
  @keyframes bob { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-7px);} }
  .mascot-svg:hover { transform: scale(1.12); }
  .mascot-svg { transition: transform .2s ease; }

  /* ---------- Hub ---------- */
  .hub-header { text-align: center; max-width: 580px; margin: 10px 0 30px; }
  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rose);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .hub-header h1 { font-size: 32px; line-height: 1.3; }
  .hub-header p { margin-top: 12px; color: var(--text-soft); font-size: 16px; line-height: 1.6; }

  .progress-row {
    display: flex;
    gap: 10px;
    margin: 18px 0 30px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .progress-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--panel-soft);
    transition: background .4s ease, transform .4s ease;
  }
  .progress-dot.done { background: var(--gold); transform: scale(1.15); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 20px;
    width: 100%;
    max-width: 820px;
  }
  @media (max-width: 720px) {
    .card-grid { grid-template-columns: 1fr; max-width: 360px; }
  }

  .card {
    background: var(--panel);
    border-radius: 22px;
    padding: 24px 18px;
    text-align: center;
    box-shadow: var(--shadow);
    transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
    position: relative;
  }
  .card:hover { transform: translateY(-4px) rotate(-0.6deg); background: var(--panel-soft); }
  .card .icon { font-size: 38px; margin-bottom: 10px; display: block; transition: transform .3s ease; }
  .card:hover .icon { transform: scale(1.15) rotate(6deg); }
  .card h3 { font-size: 17px; margin-bottom: 6px; }
  .card p { font-size: 13px; color: var(--text-soft); margin-bottom: 16px; min-height: 34px; line-height: 1.4; }
  .play-btn {
    background: var(--rose);
    color: #2A1D24;
    padding: 10px 22px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
    transition: background .2s ease, transform .2s ease;
  }
  .play-btn:hover { background: var(--rose-deep); transform: scale(1.06); }
  .check-badge {
    position: absolute;
    top: 14px; right: 14px;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: var(--sage-deep);
    color: #17241F;
    font-size: 14px;
    display: none;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
  .check-badge.show { display: flex; }

  .final-note-btn {
    margin-top: 30px;
    background: var(--lavender);
    color: #1E1A2E;
    padding: 14px 30px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    box-shadow: var(--shadow);
    display: none;
  }
  .final-note-btn.show { display: inline-block; }
  .final-note-btn:hover { background: var(--lavender-deep); transform: translateY(-2px); }

  /* ---------- Game shells ---------- */
  .game-title { font-size: 23px; text-align: center; margin-bottom: 4px; }
  .game-sub { color: var(--text-soft); font-size: 14px; text-align: center; margin-bottom: 20px; max-width: 420px; line-height: 1.5; }
  .goal-track {
    display: flex; align-items: center; gap: 10px;
    background: var(--panel);
    padding: 10px 20px;
    border-radius: 999px;
    box-shadow: var(--shadow);
    margin-bottom: 22px;
    font-weight: 700;
    font-size: 14px;
  }

  /* ---- Memory game ---- */
  .memory-grid {
    display: grid;
    grid-template-columns: repeat(4, 72px);
    grid-gap: 11px;
    justify-content: center;
  }
  @media (max-width: 420px) {
    .memory-grid { grid-template-columns: repeat(4, 62px); }
  }
  .mem-card {
    width: 72px; height: 72px;
    border-radius: 14px;
    background: var(--lavender);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
    box-shadow: var(--shadow);
    cursor: pointer;
    transition: transform .3s ease, background .3s ease;
    user-select: none;
  }
  @media (max-width: 420px) { .mem-card { width: 62px; height: 62px; font-size: 24px; } }
  .mem-card:hover { transform: scale(1.05); }
  .mem-card.flipped { background: var(--panel-soft); }
  .mem-card.matched { background: var(--sage); opacity: 0.85; cursor: default; }
  .mem-card .face { display: none; }
  .mem-card.flipped .face, .mem-card.matched .face { display: block; }
  .mem-card.flipped .back, .mem-card.matched .back { display: none; }

  /* ---- Bubble game ---- */
  .bubble-field {
    position: relative;
    width: 100%; max-width: 480px; height: 420px;
    background: var(--panel);
    border-radius: 24px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .bubble {
    position: absolute;
    bottom: -60px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, var(--panel-softer), var(--bubble-color, var(--rose)));
    box-shadow: 0 4px 10px rgba(15,10,25,0.3);
    cursor: pointer;
    border: none;
    transition: transform .15s ease;
  }
  .bubble:hover { transform: scale(1.08); }
  @media (prefers-reduced-motion: no-preference) {
    .bubble { animation: floatUp linear forwards; }
  }
  @keyframes floatUp {
    to { transform: translateY(-480px); opacity: 0.1; }
  }

  /* ---- Star catcher ---- */
  .star-field {
    position: relative;
    width: 100%; max-width: 480px; height: 420px;
    background: var(--panel);
    border-radius: 24px;
    box-shadow: var(--shadow);
    overflow: hidden;
    touch-action: none;
  }
  .falling-star {
    position: absolute;
    top: -30px;
    font-size: 25px;
    user-select: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .falling-star { animation: fall linear forwards; }
  }
  @keyframes fall {
    to { transform: translateY(460px); }
  }
  .basket {
    position: absolute;
    bottom: 12px;
    width: 64px; height: 40px;
    font-size: 32px;
    text-align: center;
    transform: translateX(-50%);
  }

  /* ---- He loves me / he loves me not ---- */
  .flower-field { display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .phrase-label { font-size: 19px; font-weight: 700; min-height: 28px; text-align: center; color: var(--rose); transition: color .3s ease; }
  .flower-wrap { position: relative; width: 230px; height: 230px; }
  .flower-emoji { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); font-size: 46px; z-index: 1; }
  .petal {
    position: absolute;
    width: 24px; height: 40px;
    border-radius: 50% 50% 50% 50% / 65% 65% 35% 35%;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: transform .35s ease, opacity .35s ease;
  }
  .petal:hover { filter: brightness(1.12); }
  .petal.plucked { opacity: 0; pointer-events: none; }
  .flower-restart {
    background: var(--panel-soft);
    color: var(--text);
    padding: 9px 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    transition: background .2s ease;
  }
  .flower-restart:hover { background: var(--panel-softer); }

  /* ---- Rescue Cats ---- */
  .cat-field { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .cage {
    position: relative;
    width: 170px; height: 150px;
    background: var(--panel);
    border-radius: 20px;
    box-shadow: var(--shadow);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .cage-door {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--panel-softer) 0px, var(--panel-softer) 8px, var(--panel-soft) 8px, var(--panel-soft) 16px);
    border-radius: 20px;
    transition: transform .5s ease, opacity .5s ease;
  }
  .cage-door.open { transform: translateX(130%); opacity: 0; }
  .cat-emoji {
    font-size: 54px;
    position: relative;
    z-index: 1;
    transition: transform .7s ease, opacity .7s ease;
  }
  .cat-emoji.escape { transform: translate(50px, -110px) scale(0.75) rotate(12deg); opacity: 0; }
  .pins-row { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; max-width: 260px; }
  .pin {
    width: 16px; height: 48px;
    border-radius: 8px;
    background: linear-gradient(180deg, var(--gold), var(--gold-deep));
    box-shadow: var(--shadow);
    position: relative;
    transition: transform .35s ease, opacity .35s ease;
  }
  .pin::before {
    content: '';
    position: absolute;
    top: -7px; left: 50%;
    transform: translateX(-50%);
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--gold);
  }
  .pin:hover { filter: brightness(1.15); }
  .pin.pulled { transform: translateX(55px) rotate(35deg); opacity: 0; pointer-events: none; }
  .cat-caption { font-size: 14px; color: var(--text-soft); min-height: 20px; text-align: center; max-width: 320px; line-height: 1.5; }

  /* ---- Love notes quiz ---- */
  .quiz-card {
    background: var(--panel);
    border-radius: 22px;
    padding: 28px 26px;
    max-width: 440px;
    width: 100%;
    box-shadow: var(--shadow);
    text-align: center;
  }
  .quiz-question { font-size: 18px; font-weight: 700; margin-bottom: 20px; line-height: 1.5; }
  .quiz-options { display: flex; flex-direction: column; gap: 10px; }
  .quiz-option {
    background: var(--panel-soft);
    color: var(--text);
    padding: 12px 16px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    transition: background .2s ease, transform .15s ease;
  }
  .quiz-option:hover { background: var(--panel-softer); transform: translateX(3px); }
  .quiz-option.correct { background: var(--sage); color: #17241F; }
  .quiz-option.wrong { background: var(--rose-deep); color: #2A1414; }
  .quiz-reply {
    margin-top: 16px;
    font-size: 14px;
    color: var(--gold);
    font-weight: 700;
    min-height: 20px;
    opacity: 0;
    transition: opacity .4s ease;
  }
  .quiz-reply.show { opacity: 1; }
  .quiz-progress { margin-top: 14px; font-size: 13px; color: var(--text-soft); }

  /* ---------- Modal ---------- */
  .modal-backdrop {
    position: fixed; inset: 0;
    background: rgba(15,10,25,0.55);
    display: none;
    align-items: center; justify-content: center;
    z-index: 20;
    padding: 20px;
  }
  .modal-backdrop.show { display: flex; }
  .modal {
    background: var(--panel);
    border-radius: 24px;
    padding: 34px 30px;
    max-width: 400px;
    text-align: center;
    box-shadow: 0 20px 50px rgba(10,6,18,0.5);
  }
  .modal .modal-icon { font-size: 42px; margin-bottom: 10px; display: block; }
  .modal h3 { font-size: 20px; margin-bottom: 12px; }
  .modal p { color: var(--text-soft); font-size: 15px; line-height: 1.65; margin-bottom: 22px; }
  .modal button {
    background: var(--rose);
    color: #2A1D24;
    padding: 10px 26px;
    border-radius: 999px;
    font-weight: 700;
    transition: background .2s ease, transform .15s ease;
  }
  .modal button:hover { background: var(--rose-deep); transform: scale(1.04); }

  /* ---------- Final screen ---------- */
  .final-card {
    background: var(--panel);
    border-radius: 28px;
    padding: 44px 34px;
    max-width: 560px;
    text-align: center;
    box-shadow: var(--shadow);
  }
  .final-card .display { font-size: 25px; margin-bottom: 20px; }
  .final-card p { font-size: 16px; line-height: 1.8; color: var(--text); text-align: left; margin-bottom: 16px; }
  .final-card .sign-off { margin-top: 22px; font-family: 'Quicksand', sans-serif; font-weight: 700; color: var(--rose); font-size: 17px; text-align: center; }
</style>
</head>
<body>

<div class="glow-layer" id="glowLayer"></div>

<div class="mascot-wrap" id="mascotWrap">
  <div class="mascot-bubble" id="mascotBubble"></div>
  <svg class="mascot-svg" width="54" height="54" viewBox="0 0 54 54">
    <polygon points="27,3 33,20 51,20 36,31 42,49 27,38 12,49 18,31 3,20 21,20"
      fill="#D9AE6E" stroke="#C79A54" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M20 26 Q24 30 28 26" stroke="#3B3152" stroke-width="2" fill="none" stroke-linecap="round"/>
    <circle cx="20" cy="22" r="1.8" fill="#3B3152"/>
    <circle cx="29" cy="22" r="1.8" fill="#3B3152"/>
  </svg>
</div>

<!-- HUB -->
<div class="screen active" id="screen-hub">
  <div class="hub-header">
    <div class="eyebrow">a tiny arcade, built just for you</div>
    <h1>Skip the reels for a while. Come play with me instead 🌙</h1>
    <p>Six cozy little games, no timers, no losing, nothing bright or flashy. Just clear each one to unlock a little note from me.</p>
  </div>

  <div class="progress-row" id="progressRow">
    <div class="progress-dot" data-game="memory"></div>
    <div class="progress-dot" data-game="bubble"></div>
    <div class="progress-dot" data-game="star"></div>
    <div class="progress-dot" data-game="flower"></div>
    <div class="progress-dot" data-game="quiz"></div>
    <div class="progress-dot" data-game="cats"></div>
  </div>

  <div class="card-grid">
    <div class="card" tabindex="0" role="button" onclick="openScreen('memory')">
      <div class="check-badge" id="badge-memory">✓</div>
      <span class="icon">🌸</span>
      <h3>Memory Bloom</h3>
      <p>Flip the petals and find all 8 matching pairs.</p>
      <div class="play-btn">Play</div>
    </div>
    <div class="card" tabindex="0" role="button" onclick="openScreen('bubble')">
      <div class="check-badge" id="badge-bubble">✓</div>
      <span class="icon">🫧</span>
      <h3>Bubble Drift</h3>
      <p>Pop 22 slow, floaty bubbles. No rush at all.</p>
      <div class="play-btn">Play</div>
    </div>
    <div class="card" tabindex="0" role="button" onclick="openScreen('star')">
      <div class="check-badge" id="badge-star">✓</div>
      <span class="icon">⭐</span>
      <h3>Starcatcher</h3>
      <p>Move the little basket and catch 16 falling stars.</p>
      <div class="play-btn">Play</div>
    </div>
    <div class="card" tabindex="0" role="button" onclick="openScreen('flower')">
      <div class="check-badge" id="badge-flower">✓</div>
      <span class="icon">🌼</span>
      <h3>He Loves Me, He Loves Me Not</h3>
      <p>Pluck every petal. We both already know how this ends.</p>
      <div class="play-btn">Play</div>
    </div>
    <div class="card" tabindex="0" role="button" onclick="openScreen('quiz')">
      <div class="check-badge" id="badge-quiz">✓</div>
      <span class="icon">💌</span>
      <h3>Love Notes Quiz</h3>
      <p>Silly, lovely questions about us. There's always a right answer.</p>
      <div class="play-btn">Play</div>
    </div>
    <div class="card" tabindex="0" role="button" onclick="openScreen('cats')">
      <div class="check-badge" id="badge-cats">✓</div>
      <span class="icon">🐱</span>
      <h3>Rescue Cats</h3>
      <p>Pull the pins, free the kittens. Gets a little trickier each round.</p>
      <div class="play-btn">Play</div>
    </div>
  </div>

  <button class="final-note-btn" id="finalBtn" onclick="openScreen('final')">Open your note 💌</button>
</div>

<!-- MEMORY GAME -->
<div class="screen" id="screen-memory">
  <div class="top-bar"><button class="back-btn" onclick="openScreen('hub')">← back</button></div>
  <h2 class="game-title">Memory Bloom</h2>
  <p class="game-sub">Find all 8 matching pairs</p>
  <div class="goal-track">Pairs found: <span id="memoryScore">0</span> / 8</div>
  <div class="memory-grid" id="memoryGrid"></div>
</div>

<!-- BUBBLE GAME -->
<div class="screen" id="screen-bubble">
  <div class="top-bar"><button class="back-btn" onclick="openScreen('hub')">← back</button></div>
  <h2 class="game-title">Bubble Drift</h2>
  <p class="game-sub">Tap the bubbles as they float by, slow and easy</p>
  <div class="goal-track">Popped: <span id="bubbleScore">0</span> / 22</div>
  <div class="bubble-field" id="bubbleField"></div>
</div>

<!-- STAR GAME -->
<div class="screen" id="screen-star">
  <div class="top-bar"><button class="back-btn" onclick="openScreen('hub')">← back</button></div>
  <h2 class="game-title">Starcatcher</h2>
  <p class="game-sub">Move your mouse (or finger) left and right to catch stars</p>
  <div class="goal-track">Caught: <span id="starScore">0</span> / 16</div>
  <div class="star-field" id="starField">
    <div class="basket" id="basket" style="left:50%;">🧺</div>
  </div>
</div>

<!-- FLOWER GAME -->
<div class="screen" id="screen-flower">
  <div class="top-bar"><button class="back-btn" onclick="openScreen('hub')">← back</button></div>
